# Documentation only: the server reads environment variables, not .env files.
BIND_ADDR=127.0.0.1:3000
RUST_LOG=feedback_backend=info
# Development-only guard for GET /api/admin/feedback. Leave unset to disable the route.
# Must be at least 32 bytes and should be generated randomly. Never commit a real token.
ADMIN_REVIEW_TOKEN=replace-with-at-least-32-random-bytes
